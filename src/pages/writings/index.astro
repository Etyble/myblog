---
import PostList from "../../components/PostList.astro";
import Layout from "../../layouts/Layout.astro";
import { publishedPosts } from "../../utils/content";

const writings = await publishedPosts("writings");
---

<Layout title="碎碎念 — MyWorld" description="随笔、散文、碎片。">
  <section class="section">
    <div class="container">
      <h1 class="page-title">碎碎念</h1>
      <div class="page-intro">
        <p>为什么我们渴望别人理解？</p>
        <p>因为我们在孤独中感到恐惧和无助</p>
      </div>
      <PostList posts={writings} section="writings" empty="还没有文章哦。" />
    </div>
  </section>
</Layout>

<style>
  .page-intro {
    color: var(--text-muted);
    margin-bottom: 48px;
  }
</style>
