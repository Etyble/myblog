---
import Layout from "../layouts/Layout.astro";
import { withBase } from "../utils/url";
---

<Layout title="页面不存在 — MyWorld" description="这个页面不存在。">
  <section class="section">
    <div class="container">
      <p class="code">404</p>
      <h1 class="page-title">这里什么都没有</h1>
      <p class="page-desc">
        你要找的页面不存在，或者已经被移走了。<br />
        也许是链接打错了，也许是它从来没存在过。
      </p>

      <nav class="links">
        <a href={withBase("/")}>回到主页</a>
        <a href={withBase("/blog")}>博客</a>
        <a href={withBase("/writings")}>碎碎念</a>
        <a href={withBase("/tools")}>工具</a>
        <a href={withBase("/originalworldview")}>设定集</a>
      </nav>
    </div>
  </section>
</Layout>

<style>
  .section {
    padding: 120px 0;
  }

  .code {
    font-size: clamp(4rem, 14vw, 8rem);
    font-weight: 700;
    line-height: 1;
    margin-bottom: 8px;
    background: linear-gradient(135deg, #a78bfa 0%, #7c3aed 40%, #6366f1 70%, #a78bfa 100%);
    background-size: 200% 200%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .page-title {
    font-size: 1.5rem;
    margin-bottom: 16px;
  }

  .page-desc {
    color: var(--text-muted);
    line-height: 1.9;
    margin-bottom: 40px;
    max-width: 520px;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  .links a {
    font-size: 0.9rem;
    padding: 8px 16px;
    border: 1px solid var(--border);
    border-radius: 100px;
    transition: border-color 0.2s, color 0.2s;
  }

  .links a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
</style>
