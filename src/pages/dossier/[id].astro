---
import { render } from "astro:content";
import Article from "../../components/Article.astro";
import { publishedPosts } from "../../utils/content";

export async function getStaticPaths() {
  const dossiers = await publishedPosts("dossier");
  return dossiers.map((dossier) => ({
    params: { id: dossier.id },
    props: { dossier },
  }));
}

const { dossier } = Astro.props;
const { Content } = await render(dossier);
---

<Article title={dossier.data.title} description={dossier.data.description} date={dossier.data.date}>
  <Content />
</Article>
