---
import PostList from "../../components/PostList.astro";
import Layout from "../../layouts/Layout.astro";
import { publishedPosts } from "../../utils/content";

const posts = await publishedPosts("blog");
---

<Layout title="博客 — MyWorld" description="工作进展与技术记录。">
  <section class="section">
    <div class="container">
      <h1 class="page-title">博客</h1>
      <p class="page-desc">工作进展、技术记录。</p>
      <PostList posts={posts} section="blog" empty="还没有文章。" />
    </div>
  </section>
</Layout>
