<style is:global>
  /* 原本有两卷、靠标签切换；现在只剩一卷，样式直接作用在面板上。 */
  .dossier-panel {
    position: relative;
    animation: page-flip-in 0.35s ease-out;
  }

  /* Peek: stacked dossier edges (top + right) */
  .dossier-panel::before {
    content: "";
    position: absolute;
    top: -5px;
    left: 4px;
    right: -5px;
    bottom: -5px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    z-index: -2;
    opacity: 0.4;
  }

  .dossier-panel::after {
    content: "";
    position: absolute;
    top: -9px;
    left: 2px;
    right: -9px;
    bottom: -9px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    z-index: -3;
    opacity: 0.25;
  }

  @keyframes page-flip-in {
    from {
      opacity: 0;
      transform: translateX(24px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }
</style>
