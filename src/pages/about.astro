---
import Layout from "../layouts/Layout.astro";
import { withBase } from "../utils/url";

// `pct` drives the bar fill; `score`/`max` drive the printed number. They are
// deliberately independent — the dossier is meant to read as inconsistent.
type Stat = { label: string; pct: number; score: number; max: number };

const coreStats: Stat[] = [
  { label: "生命", pct: 32, score: 32, max: 100 },
  { label: "理智", pct: 12, score: 12, max: 100 },
  { label: "道心", pct: 94, score: 94, max: 100 },
];
---

