---
import Layout from "../layouts/Layout.astro";
---

<Layout title="关于我 — MyWorld" description="Etyble 的机密档案。">
  <section class="about-page">
    <div class="container">

      <!-- Folder Tabs -->
      <div class="folder-tabs">
        <button class="folder-tab active" data-page="1">卷一 · 人格档案</button>
        <button class="folder-tab" data-page="2">卷二 · 职业能力</button>
      </div>

      <!-- ===== Page 1: Main Dossier ===== -->
      <div class="dossier-page active" data-page="1">
        <div class="dossier-panel">

        <!-- Top strip: header -->
        <div class="panel-top">
          <div class="panel-badge">
            <span class="badge-class">四级权限 · 机密档案</span>
            <span class="badge-id">卷宗 ET-001</span>
          </div>
          <div class="panel-right">
            <span class="panel-org">审判庭档案馆 · 理想主义教团</span>
            <div class="panel-class">████ 机密 ████</div>
          </div>
        </div>

        <!-- Body -->
        <div class="panel-body">
          <!-- Photo + Core -->
          <div class="id-section">
            <div class="id-photo">
              <div class="photo-placeholder">
                <img
                  src={import.meta.env.BASE_URL === "/" ? "/avatar.jpg" : import.meta.env.BASE_URL + "/avatar.jpg"}
                  alt="Etyble"
                  onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"
                />
                <span class="photo-fallback">ET</span>
              </div>
              <div class="photo-label">SUBJECT #001 · 幼年期影像</div>
            </div>
            <div class="id-core">
              <h1>Etyble <span class="aka">/ 心乱</span></h1>
              <p class="id-title">剑道未竟，心魔未斩</p>
              <p class="id-status">
                <span class="status-dot active"></span>
                状态：活跃 · 游荡于现实宇宙
              </p>
              <div class="core-bars">
                <div class="core-bar">
                  <span class="core-label">生命</span>
                  <div class="core-track"><i style="width:73%"></i></div>
                  <span class="core-val">53/100</span>
                </div>
                <div class="core-bar">
                  <span class="core-label">理智</span>
                  <div class="core-track"><i style="width:58%"></i></div>
                  <span class="core-val">24/100</span>
                </div>
                <div class="core-bar">
                  <span class="core-label">创造力</span>
                  <div class="core-track"><i style="width:88%"></i></div>
                  <span class="core-val">88/100</span>
                </div>
                <div class="core-bar">
                  <span class="core-label">行动力</span>
                  <div class="core-track"><i style="width:64%"></i></div>
                  <span class="core-val">84/100</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Two column body -->
          <div class="dossier-body">
            <!-- LEFT: Stats -->
            <div class="col-left">
              <!-- Vital Stats -->
              <div class="block">
                <h3>▎基础数据</h3>
                <table class="stat-table">
                  <tr><td>代号</td><td>Etyble <span class="stat-note">← empty + bottle</span></td></tr>
                  <tr><td>当前昵称</td><td>心乱</td></tr>
                  <tr><td>MBTI</td><td>INF?TP</td></tr>
                  <tr><td>阵营</td><td>混沌·善良</td></tr>
                  <tr><td>休眠</td><td>随机</td></tr>
                  <tr><td>喜欢的数字</td><td>42</td></tr>
                  <tr><td>当前状态</td><td>饥饿</td></tr>
                  <tr><td>威胁等级</td><td class="threat-minimal">MINIMAL</td></tr>
                  <tr><td>收容状态</td><td>未收容 · 自由个体</td></tr>
                </table>
              </div>

              <!-- Equipment -->
              <div class="block">
                <h3>▎装备槽</h3>
                <table class="stat-table">
                  <tr><td>灵魂形态</td><td>虚无 · 存在 · 荒诞合一形态</td></tr>
                  <tr><td>主武器</td><td>希望</td></tr>
                  <tr><td>副武器</td><td>创造力</td></tr>
                  <tr><td>防具</td><td>虚无</td></tr>
                  <tr><td>饰品</td><td>互联网文化</td></tr>
                </table>
              </div>

              <!-- Affiliations -->
              <div class="block">
                <h3>▎已知关联</h3>
                <table class="stat-table">
                  <tr><td>众生</td><td>给予个体真相</td></tr>
                  <tr><td>朋友</td><td>用于维持个体稳定</td></tr>
                  <tr><td>艺术家们</td><td>曾给予个体启迪</td></tr>
                  <tr><td>帝皇</td><td>曾于尼莫点进行短暂交谈</td></tr>
                  <tr><td>色孽冠军</td><td>曾给予个体蛊惑</td></tr>
                  <tr><td>吸魂鬼</td><td>仇敌</td></tr>
                </table>
              </div>
            </div>

            <!-- RIGHT: Lore + Skills -->
            <div class="col-right">

              <!-- Psych Evaluation -->
              <div class="block">
                <h3>▎心理评估摘要</h3>
                <p>童年阶段，个体智识未全，误入“完美主义”，引发强迫性思维及焦虑症状，纷扰至今。</p>
                <p>中学阶段，个体于困境中悟出<strong>"人固有一死，不如尝遍人生精彩"</strong>。初次尝试修复“完美主义”漏洞。</p>
                <p>大学阶段，个体草创<strong>"虚无剑道"</strong>，后将其发展为三剑合一形态，可斩万物。在长期与虚无的搏斗中，坠入"陷入虚无—寻找解药—误以为得救—再次坠入"循环。最终在阅读与思考中参悟<strong>"要爱生活本身，不要爱生活的意义"</strong>。</p>
                <p>出租屋阶段，个体投身于众生中，寻得一缕天地大道，知授业恩师，受无极之法，剑指仇敌，道心愈坚。以虚无淬炼存在与荒诞，窥得世界本源，剑法愈烈。</p>
                <p>个体为钻研自身，曾将自身形态投射于无数其他个体，受其反噬，至今不得结果。</p>
                <p>当前心理状态：<strong>稳定临界点</strong>。已将虚无、存在、荒诞"三剑合一"。个体坚信<strong>物质是世界基础</strong>，要影响世界就不得不影响物质。在此基础之上，修心是利器，用于驾驭虚无。善良和浪漫是其底色。</p>
                <p class="eval-stamp">评估结论：适合自由行动。不建议限制。建议保持当前生存环境中的自由参数。</p>
              </div>

              <!-- Tags -->
              <div class="block">
                <h3>▎特征标签</h3>
                <div class="tag-set">
                  <span>唯物主义</span><span>实用主义</span><span>理想主义</span><span>浪漫主义</span>
                  <span>探险者</span><span>新世纪耍起战士</span><span>自由意志</span>
                  <span>死线战士</span><span>社交恐怖分子</span>
                  <span>游戏</span><span>绘画</span><span>写作</span><span>音乐</span>
                  <span>战锤40K</span><span>EVA</span><span>蛊真人</span>
                  <span class="tag-empty">...</span>
                </div>
              </div>

                            <!-- Skills -->
              <div class="block">
                <h3>▎能力矩阵</h3>
                <div class="skill-list">
                  <div class="skill">
                    <div class="skill-head">
                      <span>三剑合一</span>
                      <span class="skill-lvl">MASTERY</span>
                    </div>
                    <div class="skill-bar"><i style="width:92%"></i></div>
                    <p>虚无为锋、存在为脊、荒诞为格。可斩万物。</p>
                  </div>
                  <div class="skill">
                    <div class="skill-head">
                      <span>体系架构</span>
                      <span class="skill-lvl">EXPERT</span>
                    </div>
                    <div class="skill-bar"><i style="width:75%"></i></div>
                    <p>从代码到世界观到价值分配协议，系统性构建一切。</p>
                  </div>
                  <div class="skill">
                    <div class="skill-head">
                      <span>前瞻构想</span>
                      <span class="skill-lvl">VISIONARY</span>
                    </div>
                    <div class="skill-bar"><i style="width:82%"></i></div>
                    <p>创造力引领着人类向无限的宇宙迈进。</p>
                  </div>
                  <div class="skill">
                    <div class="skill-head">
                      <span>形意勾勒</span>
                      <span class="skill-lvl">ADEPT</span>
                    </div>
                    <div class="skill-bar"><i style="width:65%"></i></div>
                    <p>创建可供视觉体验的媒介。</p>
                  </div>
                  <div class="skill">
                    <div class="skill-head">
                      <span>情绪共鸣</span>
                      <span class="skill-lvl">INNATE</span>
                    </div>
                    <div class="skill-bar"><i style="width:70%"></i></div>
                    <p>感同身受是一种奢望，但我们任为之努力。</p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- ===== Timeline (full width) ===== -->
          <div class="block block-full">
            <h3>▎行动记录 · 时间线</h3>
            <div class="timeline">
              <div class="tl-phase">
                <div class="tl-marker"></div>
                <span class="tl-era">童年–初中</span>
                <p>"好孩子"形态。成绩优异，恐惧犯错，种植焦虑。</p>
              </div>
              <div class="tl-phase">
                <div class="tl-marker"></div>
                <span class="tl-era">高中</span>
                <p>强迫性思维全面爆发。反复洗手、追求绝对直线、被害妄想、幻想绝症。濒临崩溃。</p>
              </div>
              <div class="tl-phase critical">
                <div class="tl-marker"></div>
                <span class="tl-era">2023 · 高二 · 觉醒事件</span>
                <p>一日顿悟："人固有一死，不如尝遍新鲜"。于大耍起时代前激活耍起模式，自学绘画，为班级设计LOGO、班服、班旗。首个关键转折。《过往》记录于此。</p>
              </div>
              <div class="tl-phase critical">
                <div class="tl-marker"></div>
                <span class="tl-era">2023–2024 · 宿舍时期</span>
                <p>尝试远离家庭，成为内宿生。与一位乱弹吉他，用老人机创造像素作品的"生活艺术家"遭遇，产生了深远影响。"此时此刻恰如彼时彼刻"。最快乐的一段时光。一场救赎。</p>
              </div>
              <div class="tl-phase">
                <div class="tl-marker"></div>
                <span class="tl-era">2024 · 大学前期</span>
                <p>旧系统故障复发。先后写下《虚无的开端》《陷入虚无》，在创新实践课的自学AI中找到了片刻的纯粹快乐。</p>
              </div>
              <div class="tl-phase">
                <div class="tl-marker"></div>
                <span class="tl-era">2024 · 社交实验</span>
                <p>从"社恐"短暂突变为"社交恐怖分子"，利用此机会进行了代号00042-01的不严谨社会实验。"压抑的环境里很少有勇敢的人，可惜了那么多有趣的灵魂。"</p>
              </div>
              <div class="tl-phase">
                <div class="tl-marker"></div>
                <span class="tl-era">2024–2025 · 虚无剑道</span>
                <p>在反复坠入虚无又爬起的过程中，锻造出以"虚无"一剑为根基的剑道。领悟"要爱生活本身，不要爱生活的意义"。</p>
              </div>
              <div class="tl-phase">
                <div class="tl-marker"></div>
                <span class="tl-era">2025 · 村佬进城</span>
                <p>杭州万象城——在苹果店的落地窗前看见自己缺了一半手机壳的破安卓。钱塘江边，雾很大，江水浑浊。"天呐，这就是未来么？"在苹果销售员的眼中看见了最虚无的眼神之一。</p>
              </div>
              <div class="tl-phase critical">
                <div class="tl-marker"></div>
                <span class="tl-era">2025.12 · 三剑合一</span>
                <p>杭州·龙场悟道。虚无、存在、荒诞——三者归一。此招可斩万物。"这大学读得值得!"</p>
              </div>
              <div class="tl-phase">
                <div class="tl-marker"></div>
                <span class="tl-era">2026 · 流浪宣言</span>
                <p>"我要找到一个不存在的地方，在那里生长。"将善良置于流淌的浪漫之上，风吹在人海中掀起流浪。毕业前夕，未来未定。</p>
              </div>
              <div class="tl-phase pending">
                <div class="tl-marker"></div>
                <span class="tl-era">???</span>
                <p class="redacted">[ DATA EXPUNGED — AWAITING INPUT ]</p>
              </div>
            </div>
          </div>

          <!-- Quotes -->
          <div class="block block-full block-quotes">
            <h3>▎通讯记录截获</h3>
            <div class="comms">
              <div class="comm"><span class="comm-id">INTERNAL/觉醒日志_2023</span>"未知就是生活，冒险就是生活，疯狂就是生活，自由就是生活。"</div>
              <div class="comm"><span class="comm-id">INTERNAL/哲学笔记_2024</span>"要爱生活本身，不要爱生活的意义。"<span class="comm-note">——读到这段话时，像快饿死的人吃上了热腾腾的米饭</span></div>
              <div class="comm"><span class="comm-id">INTERNAL/虚无剑道_2025</span>"心无矩则从心所欲。纵有天地广阔，任我飞扬。"</div>
              <div class="comm"><span class="comm-id">INTERNAL/流浪宣言_2026</span>"人生就是一朵巨大的流浪。"</div>
              <div class="comm"><span class="comm-id">EXT/ROOMMATE_CHANNEL</span>"此时此刻恰如彼时彼刻。"<span class="comm-note">——每一次晚自习放学</span></div>
              <div class="comm"><span class="comm-id">EXT/SOCIAL_EXPERIMENT_00042-01</span>"压抑的环境里很少有勇敢的人，可惜了那么多有趣的灵魂。"</div>
            </div>
          </div>
        </div>

        <!-- Bottom strip -->
        <div class="panel-bottom">
          <span>FILE: ET-001 // UPDATED: 2026.05.11 // COMPILED BY: INQUISITORIAL ARCHIVES</span>
          <span class="page-num">PAGE 1 OF 2</span>
        </div>
      </div>
    </div>
        </div>
  
      <!-- ===== Page 2: Professional Profile ===== -->
      <div class="dossier-page" data-page="2">
      <div class="dossier-panel">
        <div class="panel-top">
          <div class="panel-badge">
            <span class="badge-class">档案附录 · 职业档案</span>
            <span class="badge-id">卷宗 ET-001-B</span>
          </div>
          <div class="panel-right">
            <span class="panel-org">审判庭档案馆 · 理想主义教团</span>
            <div class="panel-class panel-public">████ 可公开 ████</div>
          </div>
        </div>

        <div class="panel-body">
          <div class="block">
            <h3>▎技术栈</h3>
            <div class="skill-list">
              <div class="skill">
                <div class="skill-head">
                  <span>AI 协作 · 提示词工程</span>
                  <span class="skill-lvl">MASTERY</span>
                </div>
                <div class="skill-bar"><i style="width:95%"></i></div>
                <p>深度掌握 AI 辅助开发全流程。模糊想法 → 可运行原型（前后端、脚本、SQL、测试），以 AI 加速学习陌生技术栈。</p>
              </div>
              <div class="skill">
                <div class="skill-head">
                  <span>C / C++ / Python / JS / HTML/CSS</span>
                  <span class="skill-lvl">EXPERT</span>
                </div>
                <div class="skill-bar"><i style="width:78%"></i></div>
                <p>多语言栈。熟悉软件架构设计及开发流程，能基于时空复杂度分析和优化代码。</p>
              </div>
              <div class="skill">
                <div class="skill-head">
                  <span>深度学习 & PyTorch</span>
                  <span class="skill-lvl">ADVANCED</span>
                </div>
                <div class="skill-bar"><i style="width:70%"></i></div>
                <p>了解深度学习底层原理，有独立模型开发经验。毕设方向为 AI 相关。</p>
              </div>
              <div class="skill">
                <div class="skill-head">
                  <span>视觉设计 & Blender</span>
                  <span class="skill-lvl">ADEPT</span>
                </div>
                <div class="skill-bar"><i style="width:68%"></i></div>
                <p>基础美术与线稿设计，可辅助 AI 生图。Blender 经验，能衔接 UI 与功能开发，减少协作损耗。</p>
              </div>
              <div class="skill">
                <div class="skill-head">
                  <span>项目协调 · 独狼双模</span>
                  <span class="skill-lvl">PROVEN</span>
                </div>
                <div class="skill-bar"><i style="width:72%"></i></div>
                <p>独立定位根因并验证方案。在校多次协调多角色成员完成项目交付。可独狼可团队。</p>
              </div>
            </div>
          </div>

          <!-- Ops Matrix (from original insertion, moved here) -->
<!-- ===== Deployable Operations Matrix ===== -->
          <div class="block block-full">
            <h3>▎可部署行动矩阵 · 收益能力清单</h3>
            <p class="block-intro">对象具备多种可转化为收入的技能。以下按作战域分类，标注熟练度与评估。</p>

            <h4 class="sub-block-title">I. 赛博作战域（远程 · 无需物理移动）</h4>
            <div class="ops-grid">
              <div class="ops-item ops-high"><span class="ops-name">PPT 美化/制作</span><span class="ops-tag">√</span></div>
              <div class="ops-item ops-high"><span class="ops-name">简历精修/排版</span><span class="ops-tag">√</span></div>
              <div class="ops-item ops-high"><span class="ops-name">Word 排版/文档整理</span><span class="ops-tag">√</span></div>
              <div class="ops-item ops-high"><span class="ops-name">Excel 数据处理</span><span class="ops-tag">√</span></div>
              <div class="ops-item ops-high"><span class="ops-name">文案</span><span class="ops-tag">√</span></div>
              <div class="ops-item ops-high"><span class="ops-name">视频剪辑</span><span class="ops-tag">√</span></div>
              <div class="ops-item ops-high"><span class="ops-name">手绘/插画</span><span class="ops-tag">√</span></div>
              <div class="ops-item ops-high"><span class="ops-name">海报设计</span><span class="ops-tag">√</span></div>
              <div class="ops-item ops-high"><span class="ops-name">数据标注</span><span class="ops-tag">√</span></div>
              <div class="ops-item ops-high"><span class="ops-name">游戏代练/陪玩</span><span class="ops-tag">√</span></div>
              <div class="ops-item ops-mid"><span class="ops-name">公众号排版</span><span class="ops-tag">◐ 未接触</span></div>
              <div class="ops-item ops-mid"><span class="ops-name">修图/调色</span><span class="ops-tag">◐ 基础</span></div>
              <div class="ops-item ops-low"><span class="ops-name">翻译（中英）</span><span class="ops-tag">✗ 不可</span></div>
              <div class="ops-item ops-low"><span class="ops-name">配音/朗读</span><span class="ops-tag">✗ 不可</span></div>
              <div class="ops-item ops-low"><span class="ops-name">线上客服</span><span class="ops-tag">✗ AI已替代</span></div>
            </div>

            <h4 class="sub-block-title">II. 实地作战域（需物理到场）</h4>
            <div class="ops-grid">
              <div class="ops-item ops-high"><span class="ops-name">展会/活动协助</span><span class="ops-tag">√</span></div>
              <div class="ops-item ops-high"><span class="ops-name">宠物代遛/上门喂猫</span><span class="ops-tag">√</span></div>
              <div class="ops-item ops-high"><span class="ops-name">植物浇水/取快递</span><span class="ops-tag">√</span></div>
              <div class="ops-item ops-high"><span class="ops-name">活动充场</span><span class="ops-tag">√</span></div>
              <div class="ops-item ops-high"><span class="ops-name">试吃/试饮员</span><span class="ops-tag">√</span></div>
              <div class="ops-item ops-high"><span class="ops-name">模特/群演</span><span class="ops-tag">√</span></div>
