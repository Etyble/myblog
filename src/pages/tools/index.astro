---
import Layout from "../../layouts/Layout.astro";
import MethodCard from "../../components/MethodCard.astro";
---

<Layout title="Tools — MyWorld" description="Small creative tools and experiments.">
  <section class="section">
    <div class="container">
      <h1 class="page-title">Tools</h1>
      <p class="page-desc">一些小工具，一些实验，也许有用，也许只是好玩。</p>

      <div class="method-grid">
        <MethodCard
          href="/tools/divination"
          icon="◇"
          title="占卜"
          description="各地流传下来的占法，各有各的规矩。目前的算卦与抽签只是开始。"
          tag="民俗占法"
        />

        <MethodCard
          href="/tools/personality-test"
          icon="◈"
          title="人格测试"
          description="IPIP-NEO-120，测量大五人格的五个维度与三十个面向。基于国际人格项目库的公开题库，不是占卜。"
          tag="心理测量"
        />

        <MethodCard
          href="/tools/nutrition-calc"
          icon="⚖"
          title="营养计算器"
          description="选择今天吃的食物，输入分量，计算营养是否达标。"
          tag="健康"
        />

        <MethodCard icon="△" title="Coming soon" description="更多工具开发中..." disabled />
      </div>
    </div>
  </section>
</Layout>

<style>
  .method-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
  }
</style>
