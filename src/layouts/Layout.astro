---
import "../styles/global.css";
import { withBase } from "../utils/url";

type Props = {
  title?: string;
  description?: string;
};

const {
  title = "Etyble's Blog",
  description = "Etyble 的个人网站 — 设计、思考与私货。",
} = Astro.props;

const home = withBase("/");
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={withBase("/icon.svg")} />
    <meta name="description" content={description} />
    <!-- 有意为之：本站不打算被搜索引擎收录。若以后想让文章被收录，
         删掉这一行，以及 public/robots.txt 里对应的 `Disallow` 规则。 -->
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="nav">
      <div class="container nav-inner">
        <a href={home} class="logo">Etyble's Blog</a>
        <nav>
          <a href={home}>主页</a>
          <a href={withBase("/blog")}>博客</a>
          <a href={withBase("/writings")}>碎碎念</a>
          <a href={withBase("/dossier")}>档案袋</a>
          <a href={withBase("/originalworldview")}>设定集</a>
          <a href={withBase("/gallery")}>画廊</a>
          <a href={withBase("/tools")}>工具</a>
          <a href={withBase("/about")}>关于我</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <div class="container">
        <p>&copy; {new Date().getFullYear()} MyWorld. Built with Astro.</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    backdrop-filter: blur(12px);
    background: rgba(10, 10, 15, 0.8);
    border-bottom: 1px solid var(--border);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
  }

  .logo {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text) !important;
    letter-spacing: -0.03em;
  }

  nav {
    display: flex;
    gap: 24px;
  }

  nav a {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-muted) !important;
    transition: color 0.2s;
  }

  nav a:hover {
    color: var(--text) !important;
  }

  footer {
    margin-top: 80px;
    padding: 32px 0;
    border-top: 1px solid var(--border);
    text-align: center;
  }

  footer p {
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  @media (max-width: 640px) {
    .nav-inner {
      flex-wrap: wrap;
      height: auto;
      /* 保留左右内边距：写成 `10px 0` 会把 .container 的 24px 留白清掉，
         导致 logo 贴边。 */
      padding: 10px 24px;
      gap: 8px;
    }

    .logo {
      font-size: 1rem;
    }

    nav {
      /* 不要写 width: 100%：那会让父级的 space-between 失效、链接贴左。
         margin-left: auto 保证换行后整块仍然靠右。 */
      margin-left: auto;
      justify-content: flex-end;
      gap: 10px 14px;
      flex-wrap: wrap;
      padding-bottom: 2px;
    }

    nav a {
      font-size: 0.78rem;
      white-space: nowrap;
      flex-shrink: 0;
    }
  }
</style>
