---
import "../styles/global.css";
import { withBase } from "../utils/url";

type Props = {
  title?: string;
  description?: string;
};

const {
  title = "Etyble's Blog",
  description = "Etyble 的个人网站 — 设计、思考与私货。",
} = Astro.props;

const home = withBase("/");
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- 标记脚本可用：窄屏下导航默认收起，脚本失效时仍保持可访问。 -->
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <link rel="icon" type="image/svg+xml" href={withBase("/icon.svg")} />
    <meta name="description" content={description} />
    <!-- 有意为之：本站不打算被搜索引擎收录。若以后想让文章被收录，
         删掉这一行，以及 public/robots.txt 里对应的 `Disallow` 规则。 -->
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="nav">
      <div class="container nav-inner">
        <a href={home} class="logo">Etyble's Blog</a>
        <button
          type="button"
          class="nav-toggle"
          aria-label="展开导航"
          aria-expanded="false"
          aria-controls="site-nav"
        >
          ☰
        </button>
        <nav id="site-nav">
          <a href={home}>主页</a>
          <a href={withBase("/blog")}>博客</a>
          <a href={withBase("/writings")}>碎碎念</a>
          <a href={withBase("/dossier")}>档案袋</a>
          <a href={withBase("/originalworldview")}>设定集</a>
          <a href={withBase("/gallery")}>画廊</a>
          <a href={withBase("/tools")}>工具</a>
          <a href={withBase("/about")}>关于我</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <div class="container">
        <p>&copy; {new Date().getFullYear()} MyWorld. Built with Astro.</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    backdrop-filter: blur(12px);
    background: rgba(10, 10, 15, 0.8);
    border-bottom: 1px solid var(--border);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
  }

  .logo {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text) !important;
    letter-spacing: -0.03em;
  }

  nav {
    display: flex;
    gap: 24px;
  }

  .nav-toggle {
    display: none;
  }

  nav a {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-muted) !important;
    transition: color 0.2s;
  }

  nav a:hover {
    color: var(--text) !important;
  }

  footer {
    margin-top: 80px;
    padding: 32px 0;
    border-top: 1px solid var(--border);
    text-align: center;
  }

  footer p {
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  @media (max-width: 640px) {
    .nav-inner {
      flex-wrap: wrap;
      height: auto;
      /* 保留左右内边距：写成 `10px 0` 会把 .container 的 24px 留白清掉。 */
      padding: 10px 24px;
      gap: 8px;
    }

    .logo {
      font-size: 1rem;
    }

    .nav-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
      margin-left: auto;
      padding: 0;
      background: transparent;
      border: 1px solid var(--border);
      border-radius: 8px;
      color: var(--text);
      font-size: 1.1rem;
      line-height: 1;
      cursor: pointer;
    }

    .nav-toggle:hover {
      border-color: var(--accent);
      color: var(--accent);
    }

    /* 脚本可用时，导航改为贴在按钮下方的紧凑浮层：
       宽度随内容收缩，不再铺满整行，也不会推挤页面内容。
       展开收起用透明度与位移过渡（display 切换无法过渡）。
       脚本失效时保持原来的换行布局，链接仍然可点。 */
    .js nav {
      position: absolute;
      top: calc(100% + 6px);
      right: 24px;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 2px;
      width: max-content;
      min-width: 9rem;
      max-width: calc(100vw - 48px);
      padding: 8px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 10px;
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45);
      opacity: 0;
      transform: translateY(-6px);
      visibility: hidden;
      pointer-events: none;
      transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s;
    }

    .js nav[data-open] {
      opacity: 1;
      transform: translateY(0);
      visibility: visible;
      pointer-events: auto;
    }

    .js nav a {
      padding: 8px 12px;
      border-radius: 6px;
      font-size: 0.9rem;
      text-align: left;
    }

    .js nav a:hover {
      background: rgba(255, 255, 255, 0.06);
    }

    nav a {
      font-size: 0.9rem;
    }
  }
</style>

<script>
  const navToggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
  const siteNav = document.getElementById("site-nav");

  if (navToggle && siteNav) {
    const setNavOpen = (open: boolean) => {
      siteNav.toggleAttribute("data-open", open);
      navToggle.setAttribute("aria-expanded", String(open));
      navToggle.textContent = open ? "×" : "☰";
    };

    navToggle.addEventListener("click", () => {
      setNavOpen(!siteNav.hasAttribute("data-open"));
    });

    // 点了链接就收起，避免跳转后菜单仍然展开。
    siteNav.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("a")) setNavOpen(false);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && siteNav.hasAttribute("data-open")) setNavOpen(false);
    });

    // 点菜单和按钮以外的地方收起，符合下拉菜单的预期。
    document.addEventListener("click", (event) => {
      if (!siteNav.hasAttribute("data-open")) return;
      const target = event.target as HTMLElement;
      if (!target.closest("#site-nav") && !target.closest(".nav-toggle")) setNavOpen(false);
    });
  }
</script>
